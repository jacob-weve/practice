{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "cd ../backend && uv run python -m scripts.export_openapi && cd ../web && openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts --default-non-nullable false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "15.5.27",
    "next-intl": "^4.14.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "^6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "^6",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
