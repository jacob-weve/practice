# 복사해서 backend/.env 로 사용한다. 실제 비밀값은 절대 커밋하지 않는다.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://talksoft:talksoft@localhost:5432/talksoft
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
OAUTH_REDIRECT_URIS=["http://localhost:3000/auth/callback/kakao","http://localhost:3000/auth/callback/google","http://localhost:3000/auth/callback/naver","http://localhost:8000/api/v1/auth/callback/apple"]
WEB_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# 서비스 JWT 서명 키 (RS256). scripts/gen_dev_keys.py 로 로컬 키를 만든다.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=local-1

# 제공자 토큰 암호화 키 (base64 32바이트)
DATA_ENCRYPTION_KEY=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# LLM (모델 ID는 docs/ARCHITECTURE.md §6 참고)
ANTHROPIC_API_KEY=
LLM_MODEL_LIGHT=claude-haiku-4-5
LLM_MODEL_HEAVY=claude-sonnet-5-5
LLM_MODEL_LIGHT_FALLBACK=claude-sonnet-5-5
LLM_MODEL_HEAVY_FALLBACK=claude-opus-5-5
